# --- secrets ---
.env
.env.*
!.env.example
*.pem
.dev.vars
.dev.vars.*

# --- rust ---
/target
**/*.rs.bk

# --- node / frontend ---
node_modules/
web/.next/
web/out/
*.tsbuildinfo
next-env.d.ts

# --- cloudflare worker build artifacts ---
# Root-anchored deliberately. An unanchored `worker/` also matches
# `crates/worker/` — the Worker crate itself — which silently kept the entire
# crate out of git and broke CI at the first `cargo fmt` invocation.
/worker/
/build/
.wrangler/

# --- testsprite local artifacts ---
/.testsprite/
testsprite_test_code/
/testsprite-*.xml
/testsprite-*.json

# --- os / editor ---
.DS_Store
*.swp
.idea/
.vscode/
